# Copy this file to .env and fill in the values.

PORT=3000
NODE_ENV=development

# Local MongoDB (see README for Docker / Atlas alternatives)
MONGODB_URI=mongodb://127.0.0.1:27017/collegeconnect

# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API / open sockets
CLIENT_ORIGIN=http://localhost:3000

# Optional: restrict registration to college email domains (comma-separated).
# Leave empty to allow any email while developing.
# ALLOWED_EMAIL_DOMAINS=college.edu,students.college.edu
ALLOWED_EMAIL_DOMAINS=
